{
  "name": "next-edit-inline-completions",
  "displayName": "Next Edit Inline Completions",
  "description": "Inline completion provider that surfaces predictive next edit suggestions inspired by the Next Edit proposal.",
  "version": "0.1.0",
  "publisher": "nextedit",
  "engines": {
    "vscode": "^1.92.0"
  },
  "enabledApiProposals": [
    "inlineCompletionsAdditions"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "nextEditInlineCompletions.explainSuggestion",
        "title": "Next Edit: Explain Active Suggestion"
      },
      {
        "command": "nextEditInlineCompletions.generateTelemetry",
        "title": "Next Edit: Generate Telemetry Stub"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -p . -w",
    "lint": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/vscode": "^1.92.0",
    "typescript": "^5.6.3"
  }
}
