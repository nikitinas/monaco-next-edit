{
  "name": "next-edit-demo",
  "displayName": "Next Edit Suggestions Demo",
  "description": "Command-based extension for generating next edit suggestions using inline completions API",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.99.0"
  },
  "enabledApiProposals": [
    "inlineCompletionsAdditions"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/node": "^18.0.0",
    "typescript": "^5.0.0"
  }
}